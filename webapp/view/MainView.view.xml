<mvc:View
    controllerName="ns.automatedsweepv4.automatedsweepv4.controller.MainView"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page
        id="IDPage"
        title="{i18n>title}"
        class="mainDashboardPage"
        enableScrolling="true">
        <content>
            <VBox id="IDMain" width="100%" class="mainDashboard sapUiResponsiveContentPadding">
                <Title id="dashboardHeading" text="{i18n>dashboardHeading}" level="H1" class="dashboardHeading" />
                <Text id="dashboardDescription" text="{i18n>dashboardDescription}" wrapping="true" class="dashboardDescription" />

                <IconTabBar id="reclassificationTabs" expandable="false" selectedKey="operational" class="reclassificationTabs">
                    <items>
                        <IconTabFilter id="operationalTab" key="operational" text="{i18n>operationalSectionTitle}" icon="sap-icon://process">
                            <content>
                                <FlexBox id="operationalActionGrid" wrap="Wrap" justifyContent="Start" alignItems="Stretch" class="actionGrid">
                            <VBox id="laborLoadCard" class="actionCard">
                                <Button id="ID1" width="100%" text="{i18n>laborLoadTitle}" icon="sap-icon://employee" type="Emphasized" press=".onLaborLoad" class="largeActionButton" />
                                <Text id="laborLoadDescription" text="{i18n>laborLoadDescription}" wrapping="true" class="actionDescription" />
                            </VBox>
                            <VBox id="nonLaborLoadCard" class="actionCard">
                                <Button id="ID2" width="100%" text="{i18n>nonLaborLoadTitle}" icon="sap-icon://activity-items" type="Emphasized" press=".onNonLaborLoad" class="largeActionButton" />
                                <Text id="nonLaborLoadDescription" text="{i18n>nonLaborLoadDescription}" wrapping="true" class="actionDescription" />
                            </VBox>
                            <VBox id="dcToCipCard" class="actionCard">
                                <Button id="ID4" width="100%" text="{i18n>dcToCipTitle}" icon="sap-icon://move" type="Emphasized" press=".onDCToCIP" class="largeActionButton" />
                                <Text id="dcToCipDescription" text="{i18n>dcToCipDescription}" wrapping="true" class="actionDescription" />
                            </VBox>
                            <VBox id="logisticsNodeReclassCard" class="actionCard">
                                <Button id="ID8" width="100%" text="{i18n>logisticsNodeReclassTitle}" icon="sap-icon://shipping-status" type="Emphasized" press=".onLogisticsNodeReclass" class="largeActionButton" />
                                <Text id="logisticsNodeReclassDescription" text="{i18n>logisticsNodeReclassDescription}" wrapping="true" class="actionDescription" />
                            </VBox>
                            <VBox id="opexGaReclassCard" class="actionCard">
                                <Button id="ID9" width="100%" text="{i18n>opexGaReclassTitle}" icon="sap-icon://expense-report" type="Emphasized" press=".onOpexGAReclass" class="largeActionButton" />
                                <Text id="opexGaReclassDescription" text="{i18n>opexGaReclassDescription}" wrapping="true" class="actionDescription" />
                            </VBox>
                        </FlexBox>
                            </content>
                        </IconTabFilter>
                        <IconTabFilter id="balanceSweepTab" key="balanceSweep" text="{i18n>balanceSweepSectionTitle}" icon="sap-icon://money-bills">
                            <content>
                                <FlexBox id="balanceSweepActionGrid" wrap="Wrap" justifyContent="Start" alignItems="Stretch" class="actionGrid">
                            <VBox id="casToAucCard" class="actionCard">
                                <Button id="ID5" width="100%" text="{i18n>casToAucTitle}" icon="sap-icon://process" type="Default" press=".onCasToAuc" tooltip="{i18n>balanceSweepTooltip}" class="largeActionButton" />
                                <Text id="casToAucDescription" text="{i18n>casToAucDescription}" wrapping="true" class="actionDescription" />
                            </VBox>
                            <VBox id="casToExpenseCard" class="actionCard">
                                <Button id="ID6" width="100%" text="{i18n>casToExpenseTitle}" icon="sap-icon://money-bills" type="Default" press=".onCasToExpense" tooltip="{i18n>balanceSweepTooltip}" class="largeActionButton" />
                                <Text id="casToExpenseDescription" text="{i18n>casToExpenseDescription}" wrapping="true" class="actionDescription" />
                            </VBox>
                            <VBox id="employeeContributionCard" class="actionCard">
                                <Button id="ID10" width="100%" text="{i18n>employeeContributionTitle}" icon="sap-icon://employee" type="Default" press=".onEmployeeContribution" tooltip="{i18n>balanceSweepTooltip}" class="largeActionButton" />
                                <Text id="employeeContributionDescription" text="{i18n>employeeContributionDescription}" wrapping="true" class="actionDescription" />
                            </VBox>
                            <VBox id="interestToInvestmentCard" class="actionCard">
                                <Button id="ID7" width="100%" text="{i18n>interestToInvestmentTitle}" icon="sap-icon://money-bills" type="Default" press=".onInterestToInvestment" tooltip="{i18n>balanceSweepTooltip}" class="largeActionButton" />
                                <Text id="interestToInvestmentDescription" text="{i18n>interestToInvestmentDescription}" wrapping="true" class="actionDescription" />
                            </VBox>
                        </FlexBox>
                            </content>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </content>
    </Page>
</mvc:View>
